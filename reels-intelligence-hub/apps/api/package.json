{
  "name": "@rih/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --local",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply rih-db --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply rih-db --remote --config wrangler.toml",
    "db:create": "wrangler d1 create rih-db"
  },
  "dependencies": {
    "@rih/shared": "*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
