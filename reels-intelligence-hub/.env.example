# ---------------------------------------------------------------------------
# Reels Intelligence Hub - example environment
#
# Production secrets are set automatically by `npm run setup`, which generates
# AUTH_SECRET and SECRETS_ENCRYPTION_KEY and pushes them with `wrangler secret
# put`. Use this file only for local development and manual setups.
#
# Local: copy to `apps/api/.dev.vars` (see apps/api/.dev.vars.example).
# NEVER commit real secrets.
#
# In production these are Cloudflare Worker secrets, set with:
#   npx wrangler secret put <NAME> --config apps/api/wrangler.toml
# ---------------------------------------------------------------------------

# --- Frontend (Vite, compiled into the bundle, public) ---------------------
# Base URL of the API. Empty string means "same origin" (recommended in prod).
VITE_API_BASE_URL=http://127.0.0.1:8787

# --- Worker secrets --------------------------------------------------------

# 32+ byte random string. Signs session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# 32-byte key, base64 encoded. Encrypts user-supplied provider API keys at
# rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Rotating this value makes every stored provider key undecryptable, which is
# why the UI always shows keys as "re-enter required" after a rotation.
SECRETS_ENCRYPTION_KEY=

# --- AI providers (optional at boot; can also be set per-user in Settings) --

# OpenAI (text, vision, embeddings, Whisper transcription)
OPENAI_API_KEY=

# Anthropic (text, vision)
ANTHROPIC_API_KEY=

# Google AI / Gemini (text, vision, embeddings)
GOOGLE_AI_API_KEY=

# AssemblyAI (speech transcription)
ASSEMBLYAI_API_KEY=

# --- Instagram / Meta Graph API -------------------------------------------

# Instagram Graph API app credentials (OAuth). The access tokens obtained
# through the OAuth flow are stored encrypted per connected account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# --- Cloudflare binding names are declared in apps/api/wrangler.toml ------
# DB        D1 database
# MEDIA     R2 bucket
# PIPELINE  Cloudflare Queue
# VECTORS   Vectorize index
# AI        Workers AI binding
